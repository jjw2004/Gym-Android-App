<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GymTracker" parent="Theme.Material3.Dark.NoActionBar">
        <!-- buttons -->
        <item name="colorPrimary">@color/gym_green</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- screen background -->
        <item name="android:colorBackground">@color/gym_background</item>
        <item name="colorSurface">@color/gym_background</item>

        <!-- text -->
        <item name="colorOnSurface">@color/gym_text</item>
        <item name="colorOnBackground">@color/gym_text</item>
        <item name="android:textColorPrimary">@color/gym_text</item>
        <item name="android:textColorSecondary">@color/gym_text_secondary</item>
        <item name="android:textColorTertiary">@color/gym_text</item>

        <!-- whatever you're using right now: cursor, typing underline, picked calendar day -->
        <item name="colorControlActivated">@color/gym_green</item>
        <item name="android:colorControlActivated">@color/gym_green</item>
    </style>

    <style name="Theme.GymTracker" parent="Base.Theme.GymTracker" />
</resources>